<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{NOTE}}">
  <title>{{TITLE}} · cyclofex-br</title>
  <link rel="stylesheet" href="{{ASSET_PREFIX}}docs.css">
</head>
<body>
  <a class="skip" href="#conteudo">Ir para o conteúdo</a>
  <header class="topbar">
    <div class="shell topbar-inner">
      <a class="brand" href="{{HOME}}"><span class="brand-mark" aria-hidden="true">↗</span>cyclofex-br</a>
      <span class="report-label">Relatório científico vivo</span>
    </div>
  </header>
  <div class="title-band">
    <div class="shell">
      <p class="eyebrow">{{EYEBROW}}</p>
      <p class="page-name">{{TITLE}}</p>
      <p class="title-note">{{NOTE}}</p>
    </div>
  </div>
  <div class="shell layout">
    <nav class="side-nav" aria-label="Relatório científico">
      {{NAVIGATION}}
    </nav>
    <main id="conteudo" class="document">
      {{BODY}}
      <div class="source-note">Fonte canônica: <a href="{{SOURCE}}">documento Markdown</a>. O HTML é derivado e não deve ser editado manualmente.</div>
    </main>
  </div>
  <footer>
    <div class="shell footer-inner">
      <span>cyclofex-br · relatório científico vivo</span>
      <a href="{{HOME}}">Visão geral</a>
    </div>
  </footer>
  <dialog class="image-lightbox" aria-label="Imagem ampliada">
    <button class="image-lightbox-close" type="button" aria-label="Fechar imagem ampliada">×</button>
    <figure>
      <img class="image-lightbox-image" alt="">
      <figcaption class="image-lightbox-caption"></figcaption>
    </figure>
  </dialog>
  <script src="{{ASSET_PREFIX}}docs.js" defer></script>
</body>
</html>
